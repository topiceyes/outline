# Outline 生产环境配置（192.168.11.141）
# 生成于 2026-10-21；SMTP 待填

NODE_ENV=production
URL=http://192.168.11.141:3000
PORT=3000
FORCE_HTTPS=false

SECRET_KEY=CHANGE_ME
UTILS_SECRET=CHANGE_ME

DATABASE_URL=postgres://outline:CHANGE_ME@postgres:5432/outline
DATABASE_CONNECTION_POOL_MIN=
DATABASE_CONNECTION_POOL_MAX=
REDIS_URL=redis://redis:6379

FILE_STORAGE=local
FILE_STORAGE_LOCAL_ROOT_DIR=/var/lib/outline/data
FILE_STORAGE_UPLOAD_MAX_SIZE=262144000

DEFAULT_LANGUAGE=zh_CN

# TODO: 邮件 magic link 登录所需，填入后重启生效
SMTP_SERVICE=
SMTP_USERNAME=
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM_EMAIL=

# Postgres 容器初始化用（与 DATABASE_URL 保持一致）
POSTGRES_USER=outline
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=outline
